<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>waad-logonserver</RootNamespace>
    <AssemblyName>waad-logonserver</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <TieredCompilation>true</TieredCompilation>
    <ReadyToRun>true</ReadyToRun>
    <PublishReadyToRun>true</PublishReadyToRun>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <DefineConstants>WIN32;$(DefineConstants)</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <OutputPath>bin/$(Configuration)/</OutputPath>
    <DefineConstants>LINUX;$(DefineConstants)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\binaries\shared\waad-shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\CoreWaad\src\logon\**\*.cs" Exclude="obj\**\*.cs" />
    <Content Include="..\..\..\CoreWaad\src\logon\**\*" Exclude="obj\**\*.cs" />
  </ItemGroup>

  <Target Name="GenerateGitInfo" BeforeTargets="BeforeBuild">
          <Exec WorkingDirectory="$(MSBuildThisFileDirectory)"
        Command="git rev-parse --abbrev-ref HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low"
        IgnoreExitCode="true" ContinueOnError="WarnAndContinue">
        <Output TaskParameter="ConsoleOutput" PropertyName="GitBranchName" />
      </Exec>
      <Exec WorkingDirectory="$(MSBuildThisFileDirectory)"
        Command="git rev-list --count HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low"
        IgnoreExitCode="true" ContinueOnError="WarnAndContinue">
        <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitCount" />
      </Exec>
      <PropertyGroup>
        <GitBranchName Condition="'$(GitBranchName)' == ''">unknown</GitBranchName>
        <GitCommitCount Condition="'$(GitCommitCount)' == ''">0</GitCommitCount>
      </PropertyGroup>
      <WriteLinesToFile File="$(MSBuildProjectDirectory)\GitInfo.txt" Lines="Branch: $(GitBranchName);Commit Count: $(GitCommitCount)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="GitInfo.txt" />
  </ItemGroup>

  <!-- <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <AdditionalIncludeDirectories Include="..\..\lib\win\VC\;..\..\include;..\..\src\waad-shared;%(AdditionalIncludeDirectories)" />
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <AdditionalIncludeDirectories Include="../../lib/linux;../../include;../../src/waad-shared;%(AdditionalIncludeDirectories)" />
  </ItemGroup> -->

</Project>
